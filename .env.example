# Configuración compartida por los tres servicios backend (usuarios,
# contenido, agente-tutor). Copiar a `.env` en la raíz del repo:
#
#   cp .env.example .env
#
# Cada servicio lo carga automáticamente al arrancar (ver config/settings.py).
# El archivo `.env` está en .gitignore — nunca se sube al repositorio.

# --- Común a los 3 servicios ---

# Hosts permitidos, separados por coma, sin espacios.
# Desarrollo local: dejar '*' (abierto) o vacío para usar el default de
# cada servicio. En producción, poner el/los dominios reales — nunca '*'.
#   ALLOWED_HOSTS=hanzimentor.app,www.hanzimentor.app
ALLOWED_HOSTS=*

# --- agente-tutor ---

# Motor de tutoría: MOCK (determinista, sin costo, usado en tests/demos)
# | REAL (LangGraph, requiere ANTHROPIC_API_KEY)
TUTOR_ENGINE=MOCK
TUTOR_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Notificador de "sesión lista": CONSOLE (solo loggea) | EMAIL
NOTIFICADOR=CONSOLE
EMAIL_REMITENTE=no-reply@hanzimentor.app

# Fuente de caracteres para el motor de tutoría: LOCAL (datos propios,
# sin red) | REMOTO (por HTTP; si falla, usa los datos propios).
# En REMOTO, el listado y el detalle van a catalogo-flask (CATALOGO_URL) y
# la validación de trazos a contenido (CONTENIDO_URL).
CATALOGO=LOCAL
CATALOGO_URL=http://localhost:5000
CONTENIDO_URL=http://localhost:8002

# --- Docker (docker-compose.yml) ---

# Puerto del host donde Nginx publica el gateway. Cambiarlo si el 80 ya
# está ocupado (y ajustar VITE_GATEWAY_URL en frontend/.env).
GATEWAY_PORT=80

# Base de datos del contenedor `db`. Valores de desarrollo: cambiarlos
# fuera de local. POSTGRES_HOST no va acá a propósito — lo define
# docker-compose.yml, así fuera de Docker `contenido` sigue usando SQLite.
POSTGRES_DB=contenido
POSTGRES_USER=hanzimentor
POSTGRES_PASSWORD=hanzimentor

# flask_catalogo: procesos de gunicorn. Su base (db_catalogo) vive en el
# mismo `db` y la crea el arranque del servicio.
CATALOGO_WORKERS=2

# flask_progreso y flask_sesiones: procesos de gunicorn. Sus bases
# (db_progreso y db_sesiones) también viven en `db`.
PROGRESO_WORKERS=2
SESIONES_WORKERS=2

# flask_evaluacion: procesos de gunicorn. No tiene base: no guarda estado.
EVALUACION_WORKERS=2

# flask_ejemplos: adaptador de frases de ejemplo (tatoeba | falso, sin red)
# y segundos de espera a Tatoeba antes de responder 503.
PROVEEDOR_EJEMPLOS=tatoeba
TATOEBA_TIMEOUT=3
