# Configuración compartida por los tres servicios backend (usuarios,
# contenido, agente-tutor). Copiar a `.env` en la raíz del repo:
#
#   cp .env.example .env
#
# Cada servicio lo carga automáticamente al arrancar (ver config/settings.py).
# El archivo `.env` está en .gitignore — nunca se sube al repositorio.

# --- Común a los 3 servicios ---

# Hosts permitidos, separados por coma, sin espacios.
# Desarrollo local: dejar '*' (abierto) o vacío para usar el default de
# cada servicio. En producción, poner el/los dominios reales — nunca '*'.
#   ALLOWED_HOSTS=hanzimentor.app,www.hanzimentor.app
ALLOWED_HOSTS=*

# --- agente-tutor ---

# Motor de tutoría: MOCK (determinista, sin costo, usado en tests/demos)
# | REAL (LangGraph, requiere ANTHROPIC_API_KEY)
TUTOR_ENGINE=MOCK
TUTOR_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Notificador de "sesión lista": CONSOLE (solo loggea) | EMAIL
NOTIFICADOR=CONSOLE
EMAIL_REMITENTE=no-reply@hanzimentor.app

# Fuente de caracteres para el motor de tutoría: LOCAL (datos propios,
# sin red) | REMOTO (le pega por HTTP al servicio contenido)
CATALOGO=LOCAL
CONTENIDO_URL=http://localhost:8002
