# Configuración compartida por los tres servicios backend (usuarios,
# contenido, agente-tutor). Copiar a `.env` en la raíz del repo:
#
#   cp .env.example .env
#
# Cada servicio lo carga automáticamente al arrancar (ver config/settings.py).
# El archivo `.env` está en .gitignore — nunca se sube al repositorio.

# --- Común a los 3 servicios ---

# Hosts permitidos, separados por coma, sin espacios.
# Desarrollo local: dejar '*' (abierto) o vacío para usar el default de
# cada servicio. En producción, poner el/los dominios reales — nunca '*'.
# En EC2: la Elastic IP de la instancia y el dominio, si lo hay, más
# localhost, contenido y agente_tutor. Los healthchecks entran por localhost
# y agente_tutor llama a contenido por su nombre en la red de Docker: sin
# esos nombres, Django responde DisallowedHost y agente_tutor queda unhealthy.
#   ALLOWED_HOSTS=203.0.113.10,hanzimentor.app,localhost,contenido,agente_tutor
ALLOWED_HOSTS=*

# Modo depuración de Django: 1 (desarrollo) | 0 (producción). Sin definir
# queda en 0. Con 1, los errores muestran la página de depuración de Django
# y CORS acepta cualquier origen: nunca usar 1 fuera de local.
# Este ejemplo trae 1 para que en local arranque sin claves. En EC2: 0, y
# entonces CONTENIDO_SECRET_KEY y TUTOR_SECRET_KEY son obligatorias.
DJANGO_DEBUG=1

# Claves secretas de Django, una por servicio. Nunca escribirlas en un
# archivo versionado: van solo en el `.env`, que nunca se sube al repo.
# Generar cada una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# docker-compose.yml las pasa a cada contenedor como DJANGO_SECRET_KEY. Con
# DJANGO_DEBUG=0 son obligatorias: sin ellas el servicio no arranca. En local
# (runserver), sin DJANGO_SECRET_KEY y con DJANGO_DEBUG=1 se usa una clave
# de desarrollo.
CONTENIDO_SECRET_KEY=
TUTOR_SECRET_KEY=

# Nivel de los logs de Django en consola: DEBUG | INFO | WARNING | ERROR.
# Sin definir queda en INFO. Funciona en local (runserver) y en Docker:
# docker-compose.yml lo pasa a contenido y agente_tutor. Los errores 500
# (django.request) siempre se registran con su traceback.
DJANGO_LOG_LEVEL=INFO

# --- agente-tutor ---

# Motor de tutoría: MOCK (determinista, sin costo, usado en tests/demos)
# | REAL (LangGraph, requiere ANTHROPIC_API_KEY)
TUTOR_ENGINE=MOCK
TUTOR_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Notificador de "sesión lista": CONSOLE (solo loggea) | EMAIL
NOTIFICADOR=CONSOLE
EMAIL_REMITENTE=no-reply@hanzimentor.app

# Fuente de caracteres para el motor de tutoría: LOCAL (datos propios,
# sin red) | REMOTO (por HTTP; si falla, usa los datos propios).
# En REMOTO, el listado y el detalle van a catalogo-flask (CATALOGO_URL) y
# la validación de trazos a contenido (CONTENIDO_URL).
CATALOGO=LOCAL
CATALOGO_URL=http://localhost:5000
CONTENIDO_URL=http://localhost:8002

# --- Docker (docker-compose.yml) ---

# Puerto del host donde Nginx publica el gateway. Cambiarlo si el 80 ya
# está ocupado (y ajustar VITE_GATEWAY_URL en frontend/.env).
GATEWAY_PORT=80

# Base de datos del contenedor `db`. Valores de desarrollo: cambiarlos
# fuera de local. POSTGRES_HOST no va acá a propósito — lo define
# docker-compose.yml, así fuera de Docker `contenido` sigue usando SQLite.
POSTGRES_DB=contenido
POSTGRES_USER=hanzimentor
POSTGRES_PASSWORD=hanzimentor

# flask_catalogo: procesos de gunicorn. Su base (db_catalogo) vive en el
# mismo `db` y la crea el arranque del servicio.
CATALOGO_WORKERS=2

# flask_progreso y flask_sesiones: procesos de gunicorn. Sus bases
# (db_progreso y db_sesiones) también viven en `db`.
PROGRESO_WORKERS=2
SESIONES_WORKERS=2

# flask_evaluacion: procesos de gunicorn. No tiene base: no guarda estado.
EVALUACION_WORKERS=2

# flask_evaluacion: quién explica los errores del usuario (RF-IA-04). Hoy
# solo "reglas" (determinista, sin red). Un valor desconocido detiene el
# arranque del servicio.
EXPLICADOR_ERRORES=reglas

# flask_reportes: procesos de gunicorn. No tiene base: los resultados de
# las tareas viven en Redis y caducan a las 24 h. El worker de Celery usa la
# misma imagen con --concurrency=1.
# REDIS_URL no va acá a propósito: docker-compose.yml fija
# redis://redis:6379/0 (nombre de la red de Docker). Fuera de Docker, cada
# servicio usa redis://localhost:6379/0 por defecto.
REPORTES_WORKERS=2

# flask_ejemplos: adaptador de frases de ejemplo (tatoeba | falso, sin red)
# y segundos de espera a Tatoeba antes de responder 503.
PROVEEDOR_EJEMPLOS=tatoeba
TATOEBA_TIMEOUT=3

# flask_aliado: consumo del equipo aliado, VaultDrop (T26).
#   vaultdrop: su catálogo público; ALIADO_URL es su IP elástica sin /api
#   falso:     dos cajas fijas sin red (sin internet o para pruebas)
# Segundos de espera antes de usar el último catálogo guardado.
ALIADO_PROVEEDOR=vaultdrop
ALIADO_URL=http://3.217.19.101
ALIADO_TIMEOUT=3
