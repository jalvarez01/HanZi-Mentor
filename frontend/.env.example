# Bases de la API que usa src/services/api.js. Vacías = mismo origen:
# en desarrollo las resuelve el proxy de Vite (ver VITE_GATEWAY_URL) y en
# Docker el Nginx que sirve el frontend. Solo se definen si el gateway está
# en otro origen, p. ej. http://192.168.1.10 (sin barra final).
#   catalogo-flask -> <VITE_CATALOGO_URL>/api/v2/caracteres/... y /api/v2/lecciones/...
#   sesiones-flask -> <VITE_SESIONES_URL>/api/v2/sesiones/... y /api/v2/ejercicios/...
#   progreso-flask -> <VITE_PROGRESO_URL>/api/v2/progreso/...
#   evaluacion-flask -> <VITE_EVALUACION_URL>/api/v2/evaluacion/
#   ejemplos-flask -> <VITE_EJEMPLOS_URL>/api/v2/ejemplos/...
VITE_CATALOGO_URL=
VITE_SESIONES_URL=
VITE_PROGRESO_URL=
VITE_EVALUACION_URL=
VITE_EJEMPLOS_URL=

# Destino del proxy de desarrollo para /api (Nginx). Solo lo lee vite.config.js.
VITE_GATEWAY_URL=http://localhost:80
