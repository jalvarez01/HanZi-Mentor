# Bases de la API que usa src/services/api.js. Vacías = mismo origen:
# en desarrollo las resuelve el proxy de Vite (ver VITE_GATEWAY_URL) y en
# Docker el Nginx que sirve el frontend. Solo se definen si el gateway está
# en otro origen, p. ej. http://192.168.1.10 (sin barra final).
#   contenido     -> <VITE_CONTENIDO_URL>/api/v1/...
#   agente-tutor  -> <VITE_TUTOR_URL>/api/v1/tutor/...
#   trazos-flask  -> <VITE_TRAZOS_URL>/api/v2/trazos/...
VITE_CONTENIDO_URL=
VITE_TUTOR_URL=
VITE_TRAZOS_URL=

# Destino del proxy de desarrollo para /api (Nginx). Solo lo lee vite.config.js.
VITE_GATEWAY_URL=http://localhost:80
