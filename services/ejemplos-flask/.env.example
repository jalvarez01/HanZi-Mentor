# Configuración del servicio. Todas las variables son opcionales.
# El servicio las lee del entorno: exportarlas en la terminal, pasarlas con
# `docker run --env-file` o definirlas en docker-compose.yml.

# Nombre que devuelve GET /health.
SERVICE_NAME=ejemplos-flask

# Interfaz y puerto de `python app.py`. En Docker gunicorn escucha en 5000.
HOST=0.0.0.0
PORT=5000

# 1 activa el modo debug. Solo en local, nunca en Docker.
FLASK_DEBUG=0

# Adaptador de la API de terceros que se inyecta en el caso de uso.
#   tatoeba: API pública de Tatoeba (https://api.tatoeba.org), sin clave
#   falso:   datos fijos sin red (pruebas y demos sin internet)
PROVEEDOR_EJEMPLOS=tatoeba

# URL base de la API de Tatoeba y segundos de espera antes de responder 503.
TATOEBA_URL=https://api.tatoeba.org
TATOEBA_TIMEOUT=3

# Este servicio no guarda estado: no usa DATABASE_URL.
