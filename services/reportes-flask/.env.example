# Configuración del servicio. Todas las variables son opcionales.
# El servicio las lee del entorno: exportarlas en la terminal, pasarlas con
# `docker run --env-file` o definirlas en docker-compose.yml.

# Nombre que devuelve GET /health.
SERVICE_NAME=reportes-flask

# Interfaz y puerto de `python app.py`. En Docker el puerto lo toma gunicorn.
HOST=0.0.0.0
PORT=5000

# 1 activa el modo debug. Solo en local, nunca en Docker.
FLASK_DEBUG=0

# Sin base de datos: los resultados de las tareas viven en Redis y caducan.
DATABASE_URL=

# Redis: broker de Celery, backend de resultados y notificaciones.
#   Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Segundos para conectar con Redis y esperar su respuesta en /health.
REDIS_TIMEOUT=1

# Procesos de gunicorn (solo en Docker, servicio flask_reportes).
GUNICORN_WORKERS=2
