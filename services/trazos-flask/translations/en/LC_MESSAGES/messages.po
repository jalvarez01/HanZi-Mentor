#: comparador.py:244
msgid "El carácter no tiene datos de trazo para comparar."
msgstr "The character has no stroke data to compare."

#: comparador.py:251
msgid "No se registró ningún trazo."
msgstr "No stroke was recorded."

#: comparador.py:294
msgid ""
"La forma es correcta, pero lo trazaste en sentido contrario. Revisá por "
"dónde empieza el trazo."
msgstr ""
"The shape is correct, but you drew it in the opposite direction. Check where"
" the stroke starts."

#: comparador.py:304
msgid "El trazo quedó corto. Recorré el trazo completo."
msgstr "The stroke is too short. Draw the whole stroke."

#: comparador.py:312
msgid "El trazo se pasó de largo respecto del esperado."
msgstr "The stroke went past the expected one."

#: comparador.py:320
msgid "Trazo correcto."
msgstr "Correct stroke."

#: comparador.py:327
msgid "Trazo aceptable. Con más precisión quedaría perfecto."
msgstr "Acceptable stroke. With more precision it would be perfect."

#: comparador.py:334
msgid "El trazo se alejó bastante del recorrido esperado."
msgstr "The stroke strayed quite far from the expected path."

#: errores.py:29
msgid "Solicitud incorrecta"
msgstr "Bad request"

#: errores.py:33
msgid "Recurso no encontrado"
msgstr "Resource not found"

#: errores.py:37
msgid "Método no permitido"
msgstr "Method not allowed"

#: errores.py:41 errores.py:51
msgid "Error interno"
msgstr "Internal error"

#: rutas.py:16
msgid "El cuerpo no es un JSON válido"
msgstr "The body is not valid JSON"

#: validacion.py:32
msgid "El cuerpo debe ser un objeto JSON"
msgstr "The body must be a JSON object"

#: validacion.py:36
#, python-format
msgid "Faltan campos: %(campos)s"
msgstr "Missing fields: %(campos)s"

#: validacion.py:48
#, python-format
msgid "'%(campo)s' debe ser una lista de puntos"
msgstr "'%(campo)s' must be a list of points"

#: validacion.py:50
#, python-format
msgid "'%(campo)s' necesita al menos 2 puntos"
msgstr "'%(campo)s' needs at least 2 points"

#: validacion.py:53
#, python-format
msgid "'%(campo)s' supera el máximo de %(maximo)s puntos"
msgstr "'%(campo)s' exceeds the maximum of %(maximo)s points"

#: validacion.py:64
#, python-format
msgid "'%(campo)s[%(indice)s]' debe tener 'x' e 'y'"
msgstr "'%(campo)s[%(indice)s]' must have 'x' and 'y'"

#: validacion.py:72
#, python-brace-format, python-format
msgid "'%(campo)s[%(indice)s]' debe ser [x, y] o {\"x\", \"y\"}"
msgstr "'%(campo)s[%(indice)s]' must be [x, y] or {\"x\", \"y\"}"

#: validacion.py:78
#, python-format
msgid "'%(campo)s[%(indice)s]' tiene coordenadas no numéricas"
msgstr "'%(campo)s[%(indice)s]' has non-numeric coordinates"

#: validacion.py:94
#, python-format
msgid "'%(campo)s' debe ser un entero positivo"
msgstr "'%(campo)s' must be a positive integer"

