# Configuración del servicio. Todas las variables son opcionales.
# El servicio las lee del entorno: exportarlas en la terminal, pasarlas con
# `docker run --env-file` o definirlas en docker-compose.yml.

# Nombre que devuelve GET /health.
SERVICE_NAME=sesiones-flask

# Interfaz y puerto de `python app.py`. En Docker el puerto lo toma gunicorn.
HOST=0.0.0.0
PORT=5000

# 1 activa el modo debug. Solo en local, nunca en Docker.
FLASK_DEBUG=0

# Base de datos propia del servicio (SQLAlchemy).
#   Sin definir: SQLite local en db.sqlite3
#   Vacío (DATABASE_URL=): el servicio no usa base de datos
#   Docker: postgresql+psycopg2://hanzimentor:hanzimentor@db:5432/db_sesiones
#   (base propia dentro del PostgreSQL compartido; la crea crear_base.py)
DATABASE_URL=sqlite:///db.sqlite3

# 1 crea las tablas de los modelos al arrancar.
DB_CREAR_TABLAS=1

# Servicios de los que depende, por HTTP. URL base, sin /api/v2.
#   Docker: http://flask_catalogo:5000 y http://flask_progreso:5000
CATALOGO_URL=http://localhost:5081
PROGRESO_URL=http://localhost:5083

# Segundos de espera por petición y reintentos de los GET a esos servicios.
HTTP_TIMEOUT=3
HTTP_REINTENTOS=2

# Motor del tutor (solo MOCK; el motor LangGraph sigue en agente-tutor).
TUTOR_ENGINE=MOCK
# Notificador de sesión lista:
#   consola: una línea en el log (por defecto; `console` también vale)
#   cola: publica la tarea notificar_sesion_lista en Redis para el worker
#         de reportes-flask. Si Redis no responde, la sesión se crea igual.
NOTIFICADOR=consola

# Redis (solo con NOTIFICADOR=cola) y segundos de espera al publicar.
#   Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT=1

# Procesos de gunicorn (solo en Docker).
GUNICORN_WORKERS=2
