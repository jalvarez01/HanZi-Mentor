# Configuración del servicio. Todas las variables son opcionales.
# El servicio las lee del entorno: exportarlas en la terminal, pasarlas con
# `docker run --env-file` o definirlas en docker-compose.yml.

# Nombre que devuelve GET /health.
SERVICE_NAME=aliado-flask

# Interfaz y puerto de `python app.py`. En Docker gunicorn escucha en 5000.
HOST=0.0.0.0
PORT=5000

# 1 activa el modo debug. Solo en local, nunca en Docker.
FLASK_DEBUG=0

# Adaptador del equipo aliado que se inyecta en el caso de uso.
#   vaultdrop: catálogo público de VaultDrop (necesita ALIADO_URL)
#   falso:     dos cajas fijas sin red (pruebas y local sin la IP del aliado)
ALIADO_PROVEEDOR=falso

# URL base del aliado, sin /api. Por ejemplo: http://<IP elástica de VaultDrop>
ALIADO_URL=

# Segundos de espera antes de usar el último catálogo guardado.
ALIADO_TIMEOUT=3

# Este servicio no guarda estado: no usa DATABASE_URL.
