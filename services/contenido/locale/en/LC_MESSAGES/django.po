#: caracteres/domain/comparador.py:251
msgid "El carácter no tiene datos de trazo para comparar."
msgstr "The character has no stroke data to compare."

#: caracteres/domain/comparador.py:258
msgid "No se registró ningún trazo."
msgstr "No stroke was recorded."

#: caracteres/domain/comparador.py:301
msgid ""
"La forma es correcta, pero lo trazaste en sentido contrario. Revisá por "
"dónde empieza el trazo."
msgstr ""
"The shape is correct, but you drew it in the opposite direction. Check where"
" the stroke starts."

#: caracteres/domain/comparador.py:311
msgid "El trazo quedó corto. Recorré el trazo completo."
msgstr "The stroke is too short. Draw the whole stroke."

#: caracteres/domain/comparador.py:319
msgid "El trazo se pasó de largo respecto del esperado."
msgstr "The stroke went past the expected one."

#: caracteres/domain/comparador.py:327
msgid "Trazo correcto."
msgstr "Correct stroke."

#: caracteres/domain/comparador.py:334
msgid "Trazo aceptable. Con más precisión quedaría perfecto."
msgstr "Acceptable stroke. With more precision it would be perfect."

#: caracteres/domain/comparador.py:341
msgid "El trazo se alejó bastante del recorrido esperado."
msgstr "The stroke strayed quite far from the expected path."

#: caracteres/serializers.py:13
msgid "El punto debe tener 'x' e 'y'."
msgstr "The point must have 'x' and 'y'."

#: caracteres/serializers.py:17
msgid "El punto debe ser [x, y]."
msgstr "The point must be [x, y]."

#: caracteres/serializers.py:20
#, python-brace-format
msgid "El punto debe ser [x, y] o {'x': x, 'y': y}."
msgstr "The point must be [x, y] or {'x': x, 'y': y}."

#: caracteres/serializers.py:25
msgid "Las coordenadas del punto deben ser numéricas."
msgstr "The point coordinates must be numeric."

#: caracteres/serializers.py:36
msgid "Se necesitan al menos 2 puntos para un trazo."
msgstr "A stroke needs at least 2 points."

#: caracteres/services.py:22
#, python-format
msgid "No existe el carácter '%(hanzi)s'."
msgstr "The character '%(hanzi)s' does not exist."

#: caracteres/services.py:28
#, python-format
msgid "El carácter '%(hanzi)s' no tiene un trazo con secuencia %(secuencia)s."
msgstr "The character '%(hanzi)s' has no stroke with sequence %(secuencia)s."

#: caracteres/views.py:42
msgid "Carácter no encontrado."
msgstr "Character not found."

#: lecciones/views.py:37
msgid "Lección no encontrada."
msgstr "Lesson not found."

